# Copy to .env.local (gitignored). `node scripts/init-env.mjs` generates the random secrets for you.
# NEVER commit real values. Everything secret is read from the environment only.

PORT=4000
PUBLIC_URL=http://localhost:4000          # the public https URL in production (customer tracking links use it)
TAD_DB_PATH=.data/tad.sqlite
TICK_MS=15000

# Admin (the single shop-tablet login) and signing secrets — generated by scripts/init-env.mjs
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
SESSION_SECRET=
TRACK_SECRET=
OWN_SITE_API_KEY=                         # the own website/app sends this as X-TAD-Key

# Fleetbase (unmodified, docker/fleetbase) — create the API key in its console (Developers > API Keys)
FLEETBASE_URL=http://localhost:8000
FLEETBASE_API_KEY=
FLEETBASE_WEBHOOK_SECRET=                 # Fleetbase console > Developers > Webhooks: https://YOUR-HOST/api/fleetbase/webhook?k=<this secret>

# Self-hosted routing / address stack (docker/geo)
VROOM_URL=http://localhost:3000
OSRM_URL=http://localhost:5001
POSTCODES_URL=http://localhost:8001
PHOTON_URL=http://localhost:2322

# Management app hub (tad-management-app)
HUB_URL=
HUB_TOKEN=
HUB_WEBHOOK_SECRET=

# HubRise (register the app at hubrise.com/developers, then Connect in Settings)
HUBRISE_CLIENT_ID=
HUBRISE_CLIENT_SECRET=

# Direct delivery-platform adapters — inert until BOTH enabled=true and approved keys are set
UBEREATS_ENABLED=false
UBEREATS_CLIENT_ID=
UBEREATS_CLIENT_SECRET=
UBEREATS_WEBHOOK_SECRET=
DELIVEROO_ENABLED=false
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
JUSTEAT_ENABLED=false
JUSTEAT_API_KEY=
JUSTEAT_WEBHOOK_SECRET=

# Free customer notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC_KEY=                         # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

# Label printer (network ESC/POS)
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_TYPE=epson

# Optional: Ordnance Survey Places API for house-level UK addresses (Photon is the free default)
OS_PLACES_API_KEY=

# Used by scripts/fleetbase-brand.mjs only
FLEETBASE_ADMIN_EMAIL=
FLEETBASE_ADMIN_PASSWORD=
